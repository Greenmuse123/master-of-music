{
  "name": "master-of-music",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "tools/asset-pipeline"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit && npm --workspace @master-of-music/asset-pipeline run typecheck",
    "assets": "vite-node tools/asset-pipeline/src/cli.ts",
    "test": "vitest run",
    "test:run": "vitest run",
    "verify:workflow": "node scripts/verify-workflow.cjs"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20.17.24",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.1",
    "js-yaml": "4.1.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
